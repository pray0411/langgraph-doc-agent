# ===== 模型配置（三选一）=====
# 1) DeepSeek（国内直连、便宜，推荐练手）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 2) OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# 3) 离线演示模式（不需要任何 Key，检索结果拼接回答）
# LLM_PROVIDER=offline

# ===== 检索配置 =====
# local: 内置 TF-IDF 检索（零依赖）；remote: 使用 embedding API（需 Key）
EMBEDDING_MODE=local
TOP_K=3

# ===== 联网搜索（可选，推荐）=====
# 博查 Bocha API Key（国内中文搜索质量高，Agent 专用）：https://open.bochaai.com 注册获取
# 配置后 web_search 优先用博查；未配置则退回 DuckDuckGo
# BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxx
