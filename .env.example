# ===== 模型配置（三选一）=====
# 1) DeepSeek（国内直连、便宜，推荐）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 2) OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# 3) 本地 Ollama（免费，需自行安装 Ollama 并拉取模型）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ===== 检索配置 =====
# 混合检索：BM25（jieba）+ 语义向量（sentence-transformers，本地运行，首次自动下载模型）
# 语义模型不可用时自动回退纯 BM25
TOP_K=3
# 检索最低融合分数阈值
MIN_SCORE=0.0
# 语义模型（sentence-transformers 模型名，下载缓存到 models/）
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ===== 多轮记忆 =====
# 会话记忆存储位置（SQLite checkpointer，按 thread_id 持久化，重启不丢）
# MEMORY_DB=data/memory.sqlite

# ===== 安全（可选，推荐开启）=====
# 设置后 /ask、/api/mode、/api/config 要求请求头 X-API-Token 匹配，
# 防止本机端口被局域网/他人滥用（盗用 API 额度）
# API_TOKEN=your-secret-token

# ===== 联网搜索（可选，推荐）=====
# 博查 Bocha API Key（国内中文搜索质量高，Agent 专用）：https://open.bochaai.com 注册获取
# 配置后 web_search 优先用博查；未配置则退回 DuckDuckGo
# BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxx
