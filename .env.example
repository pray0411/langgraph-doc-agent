# ===== 模型配置（三选一）=====
# 1) DeepSeek（国内直连、便宜，推荐）
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_MODEL=deepseek-chat

# 2) OpenAI
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
# LLM_MODEL=gpt-4o-mini

# 3) 本地 Ollama（免费，需自行安装 Ollama 并拉取模型）
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=qwen2.5:7b

# ===== 检索配置 =====
# 内置 BM25 + jieba 分词检索（jieba 未安装时自动降级为 bigram）
TOP_K=3
# 检索最低分数阈值（BM25 语义：与查询无共现词即 0 分，视为无关）
MIN_SCORE=0.0

# ===== 联网搜索（可选，推荐）=====
# 博查 Bocha API Key（国内中文搜索质量高，Agent 专用）：https://open.bochaai.com 注册获取
# 配置后 web_search 优先用博查；未配置则退回 DuckDuckGo
# BOCHA_API_KEY=sk-xxxxxxxxxxxxxxxx
